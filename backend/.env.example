# ---------- App ----------
ENVIRONMENT=development
# Public URL of this API. Telephony providers call back here - use your ngrok/public URL for real calls.
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:5173"]

# ---------- Auth ----------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# The platform admin (registers companies). Created on first start; change the password after signing in.
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=admin12345
# Encrypts each company's Twilio / WhatsApp tokens in the database. Empty = derived from JWT_SECRET_KEY.
# Changing it later makes stored tokens unreadable (companies must re-enter them).
SECRETS_ENCRYPTION_KEY=

# ---------- Infrastructure ----------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_platform
REDIS_URL=redis://localhost:6379/0
STORAGE_DIR=./storage

# ---------- Gemini (empty key = offline fake LLM for local dev) ----------
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# ---------- WhatsApp Cloud API ----------
# Each company connects its own WhatsApp number, access token and app secret in the portal (Company Settings).
# Until a company does, WhatsApp is off for it: there is no shared account and no fallback.
# The verify token is the only shared value: Meta sends it once, when the webhook URL is registered.
WHATSAPP_VERIFY_TOKEN=verify-me

# --- Email support (SendGrid) ---
# Each company connects its own SendGrid API key and support address in Company Settings.
# This is the master switch: false = no email is sent for any company.
EMAIL_ENABLED=true

# ---------- Telephony ----------
# Each company connects its own Twilio account and calling number in the portal (Company Settings).
# Until a company does, calling is off for it: its campaigns cannot be scheduled. No shared account, no fallback.
VOICE_NAME=Polly.Aditi  # only used with SPEECH_PROVIDER=twilio, or as fallback if Sarvam fails

# ---------- Speech on real calls: sarvam | twilio ----------
# sarvam = Sarvam Bulbul voice (TTS) + Sarvam Saaras recognition (STT); understands Hindi, English and Hinglish.
SPEECH_PROVIDER=sarvam
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=codemix          # Hinglish-friendly transcripts
SARVAM_STT_LANGUAGE=unknown      # auto-detect Hindi/English per answer; empty = campaign language
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=priya         # bulbul:v3 voices: priya, neha, ritu, pooja, simran, kavya, shubh, aditya, rahul, rohan, amit, dev ...
SARVAM_TTS_PACE=1.0

# ---------- Outbound ----------
DEFAULT_PHONE_REGION=IN
GLOBAL_MAX_CONCURRENT_CALLS=20
