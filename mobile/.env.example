# Address of the backend, as the PHONE can reach it. "localhost" does not work on a phone.
#   Same Wi-Fi as the PC:  http://192.168.1.20:8000   (the PC's Wi-Fi address; find it with `ipconfig`)
#   From anywhere:         https://your-tunnel.trycloudflare.com   (the same address as PUBLIC_BASE_URL)
# It can also be changed on the app's login screen ("Server address"), without restarting anything.
EXPO_PUBLIC_API_URL=http://192.168.1.20:8000
